# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata

# Raw HTML snapshots of the old site, used as the content-migration source
.crawl/

# Source photo library (~285MB of full-resolution originals). Images used on the
# site are compressed and copied into assets/img/photos/, which IS tracked.
.images/

# Ruby
.bundle/
vendor/

# macOS
.DS_Store

# Working files — kept locally, never in the repo.
# Root-anchored on purpose: the site's own content is .md and .html, so a bare
# "*.md" would swallow _faculty/, _news/, _pages/ and every layout.
/*.csv
/tpcb_landing_example.html
/REBUILD-PROMPT.md
/build_faculty_directory.md
/ADMIN-GUIDE.md
/CLAUDE-CODE-BRIEF.md

# Session notes and internal reference. Excluded from the built site as well as
# the repo — see the `exclude:` list in _config.yml, which has to match.
/CLAUDE.md
/HANDOFF.md
/TOOLS.md
